# Safe default. Do not change this default to live.
TRADING_MODE=paper

APP_NAME=AI Trading Bot
APP_ENV=development

# Paper trading configuration. All trades are simulated locally.
PAPER_INITIAL_BALANCE_USDT=10000
PAPER_FEE_RATE=0.002
PAPER_SLIPPAGE_BPS=5
PAPER_MIN_CONFIDENCE=0.55
PAPER_MAX_ORDER_FRACTION=0.10
PAPER_DB_PATH=data/paper_trading.sqlite3

# Persistent ML state. Back these directories up/sync them before moving machines.
MODEL_REGISTRY_PATH=state/model_registry
ML_RUNS_PATH=logs/ml
ML_CHECKPOINTS_PATH=models/checkpoints

# CoinEx credentials are optional and belong ONLY in your local .env file.
# They are used only for read-only private account diagnostics/balances.
# Public market prices and candles do not require these credentials.
# Never commit real values.
COINEX_ACCESS_ID=
COINEX_SECRET_KEY=

# Optional historical BTC news/sentiment source.
# Create a personal Alpha Vantage key and put the real value only in .env.
ALPHAVANTAGE_API_KEY=

# Other providers/models can be added later.
# OPENAI_API_KEY=
