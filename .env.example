# Safe default. Do not change this default to live.
TRADING_MODE=paper

APP_NAME=AI Trading Bot
APP_ENV=development

# CoinEx credentials belong ONLY in your local .env file.
# Never commit real values.
COINEX_ACCESS_ID=
COINEX_SECRET_KEY=

