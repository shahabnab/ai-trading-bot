# Safe default. Live execution remains disabled by backend/config.py.
TRADING_MODE=paper
APP_NAME=AI Trading Bot
APP_ENV=development

PAPER_INITIAL_BALANCE_USDT=1000
PAPER_MODEL_INITIAL_BALANCE_EUR_EQUIV=1000
PAPER_FEE_RATE=0.002
PAPER_SLIPPAGE_BPS=5
PAPER_MIN_CONFIDENCE=0.55
PAPER_MAX_ORDER_FRACTION=0.10
PAPER_MAX_SYMBOL_EXPOSURE_FRACTION=0.20
PAPER_MAX_TOTAL_EXPOSURE_FRACTION=0.50
PAPER_MAX_DAILY_DRAWDOWN_FRACTION=0.05
PAPER_DB_PATH=data/paper_trading.sqlite3

# Regime-aware Trader-Brain. XGBoost stacking activates only after enough resolved OOS rows.
TRADER_BRAIN_MIN_EDGE_BPS=5
TRADER_BRAIN_MIN_DIRECTION_PROBABILITY=0.58
TRADER_BRAIN_MAX_REGIME_ENTROPY=0.92
TRADER_BRAIN_UNCERTAINTY_PENALTY=0.25
TRADER_BRAIN_META_MIN_SAMPLES=200

# PAPER-only contextual-bandit learning. It follows the supervised MoE during warm-up.
TRADER_BRAIN_BANDIT_PAPER_ENABLED=true
TRADER_BRAIN_BANDIT_MIN_SAMPLES=100
TRADER_BRAIN_BANDIT_ALPHA=0.35

MODEL_REGISTRY_PATH=state/model_registry
ML_RUNS_PATH=logs/ml
ML_CHECKPOINTS_PATH=models/checkpoints

# Optional read-only CoinEx account diagnostics. Public market data does not require these.
COINEX_ACCESS_ID=
COINEX_SECRET_KEY=

# Optional historical news/sentiment collector.
ALPHAVANTAGE_API_KEY=
